{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info">{{ heading_help|raw }}</div>

    <div id="alert"></div>

    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <ul class="nav nav-tabs" id="boxnow-tabs">
          <li class="nav-item"><a class="nav-link active" href="#tab-general" data-bs-toggle="tab">{{ tab_settings }}</a></li>
          <li class="nav-item"><a class="nav-link" href="#tab-price" data-bs-toggle="tab">{{ tab_pricing }}</a></li>
        </ul>

        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-general">

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-api-url">{{ entry_api_url }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_boxnow_api_url" value="{{ shipping_boxnow_api_url }}" placeholder="{{ entry_api_url }}" id="input-api-url" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-client-id">{{ entry_client_id }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_boxnow_client_id" value="{{ shipping_boxnow_client_id }}" placeholder="{{ entry_client_id }}" id="input-client-id" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-client-secret">{{ entry_client_secret }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_boxnow_client_secret" value="{{ shipping_boxnow_client_secret }}" placeholder="{{ entry_client_secret }}" id="input-client-secret" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-warehouse-number">{{ entry_warehouse_number }}</label>
                <div class="col-sm-10">
                  <textarea name="shipping_boxnow_warehouse_number" id="input-warehouse-number" class="form-control" rows="3" placeholder="{{ entry_warehouse_number }}">{{ shipping_boxnow_warehouse_number }}</textarea>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-partner-id">{{ entry_partner_id }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_boxnow_partner_id" value="{{ shipping_boxnow_partner_id }}" placeholder="{{ entry_partner_id }}" id="input-partner-id" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-partner-name">{{ entry_partner_name }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_boxnow_partner_name" value="{{ shipping_boxnow_partner_name }}" placeholder="{{ entry_partner_name }}" id="input-partner-name" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-partner-email">{{ entry_partner_email }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_boxnow_partner_email" value="{{ shipping_boxnow_partner_email }}" placeholder="{{ entry_partner_email }}" id="input-partner-email" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-partner-phone">{{ entry_partner_phone }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_boxnow_partner_phone" value="{{ shipping_boxnow_partner_phone }}" placeholder="{{ entry_partner_phone_hint }}" id="input-partner-phone" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
                <div class="col-sm-10">
                  <select name="shipping_boxnow_geo_zone_id" id="input-geo-zone" class="form-select">
                    <option value="0">{{ text_all_zones }}</option>
                    {% for geo_zone in geo_zones %}
                      <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_boxnow_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="shipping_boxnow_status" value="0"/>
                    <input type="checkbox" name="shipping_boxnow_status" value="1" id="input-status" class="form-check-input"{% if shipping_boxnow_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="input-sort-order">{{ entry_sort_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_boxnow_sort_order" value="{{ shipping_boxnow_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
                </div>
              </div>

            </div>

            <div class="tab-pane fade" id="tab-price">

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="input-weight">{{ entry_banned_weight }}</label>
                <div class="col-sm-9">
                  <input type="text" name="shipping_boxnow_weight" value="{{ shipping_boxnow_weight }}" id="input-weight" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="input-weight-type">{{ entry_unit_of_measure }}</label>
                <div class="col-sm-9">
                  <select name="shipping_boxnow_weight_type" id="input-weight-type" class="form-select">
                    <option value="kilogram"{% if shipping_boxnow_weight_type == 'kilogram' %} selected{% endif %}>{{ entry_kilogram }}</option>
                    <option value="gram"{% if shipping_boxnow_weight_type == 'gram' %} selected{% endif %}>{{ entry_gram }}</option>
                  </select>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="input-default-weight">{{ entry_cart_weight }}</label>
                <div class="col-sm-9">
                  <input type="text" name="shipping_boxnow_default_weight" value="{{ shipping_boxnow_default_weight }}" id="input-default-weight" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="input-free-shipping">{{ entry_free_shipping }}</label>
                <div class="col-sm-9">
                  <input type="text" name="shipping_boxnow_free_shipping" value="{{ shipping_boxnow_free_shipping }}" id="input-free-shipping" class="form-control"/>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label" for="input-tax-class">{{ entry_tax_class }}</label>
                <div class="col-sm-9">
                  <select name="shipping_boxnow_tax_class_id" id="input-tax-class" class="form-select">
                    <option value="0">{{ text_none }}</option>
                    {% for tax_class in tax_classes %}
                      <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_boxnow_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">
                  <span data-bs-toggle="tooltip" title="{{ help_categories }}">{{ entry_categories }}</span>
                </label>
                <div class="col-sm-9">
                  <div class="row" id="category-duallist">
                    <div class="col-5">
                      <div class="card mb-0">
                        <div class="card-header py-2"><strong>{{ entry_categories_available }}</strong></div>
                        <div class="card-body p-2">
                          <input type="text" id="cat-search" class="form-control form-control-sm" placeholder="{{ entry_categories_search }}"/>
                        </div>
                        <select id="cat-available" multiple class="form-control border-0 border-top rounded-0" style="height:220px;">
                          {% for category in oc_categories %}
                            {% if category.category_id not in shipping_boxnow_categories %}
                              <option value="{{ category.category_id }}">{{ category.name }}</option>
                            {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                    </div>

                    <div class="col-2 text-center pt-5">
                      <button type="button" id="cat-add" class="btn btn-sm btn-primary d-block w-100 mb-1"><i class="fa-solid fa-chevron-right"></i></button>
                      <button type="button" id="cat-add-all" class="btn btn-sm btn-light d-block w-100 mb-3"><i class="fa-solid fa-angles-right"></i></button>
                      <button type="button" id="cat-remove" class="btn btn-sm btn-light d-block w-100 mb-1"><i class="fa-solid fa-chevron-left"></i></button>
                      <button type="button" id="cat-remove-all" class="btn btn-sm btn-danger d-block w-100"><i class="fa-solid fa-angles-left"></i></button>
                    </div>

                    <div class="col-5">
                      <div class="card mb-0">
                        <div class="card-header py-2">
                          <strong>{{ entry_categories_selected }}</strong>
                          <span id="cat-selected-count" class="badge bg-secondary">{{ shipping_boxnow_categories|length }}</span>
                        </div>
                        <select id="cat-selected" name="shipping_boxnow_categories[]" multiple class="form-control border-0 rounded-0" style="height:256px;">
                          {% for category in oc_categories %}
                            {% if category.category_id in shipping_boxnow_categories %}
                              <option value="{{ category.category_id }}" selected>{{ category.name }}</option>
                            {% endif %}
                          {% endfor %}
                        </select>
                      </div>
                    </div>
                  </div>
                  <div class="form-text"><i class="fa-solid fa-circle-info"></i> {{ help_categories }}</div>
                </div>
              </div>

              <div class="row mb-3">
                <label class="col-sm-3 col-form-label">
                  <span data-bs-toggle="tooltip" title="{{ help_payment_modules }}">{{ entry_payment_modules }}</span>
                </label>
                <div class="col-sm-9">
                  <div class="border rounded p-2" style="height:150px;overflow:auto;">
                    {% for payment_module in payment_modules %}
                      <div class="form-check">
                        <input type="checkbox" name="shipping_boxnow_payment_modules[]" value="{{ payment_module.code }}" id="payment-{{ payment_module.code }}" class="form-check-input"{% if payment_module.code in shipping_boxnow_payment_modules %} checked{% endif %}/>
                        <label class="form-check-label" for="payment-{{ payment_module.code }}">{{ payment_module.name }}</label>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>

              <div class="row mb-3">
                <div class="col-sm-12">
                  <table id="weight-value" class="table table-striped table-bordered table-hover">
                    <thead>
                      <tr>
                        <td class="text-start">{{ entry_weight_from }}</td>
                        <td class="text-start">{{ entry_weight_to }}</td>
                        <td class="text-start">{{ entry_fixed_price }}</td>
                        <td></td>
                      </tr>
                    </thead>
                    <tbody>
                      {% for weight_value in shipping_boxnow_weight_value %}
                        <tr>
                          <td><input type="text" name="shipping_boxnow_weight_value[{{ loop.index }}][from]" value="{{ weight_value.from }}" class="form-control"/></td>
                          <td><input type="text" name="shipping_boxnow_weight_value[{{ loop.index }}][to]" value="{{ weight_value.to }}" class="form-control"/></td>
                          <td><input type="text" name="shipping_boxnow_weight_value[{{ loop.index }}][price]" value="{{ weight_value.price }}" class="form-control"/></td>
                          <td class="text-center"><button type="button" class="btn btn-danger btn-boxnow-row-remove" title="{{ button_remove }}"><i class="fa-solid fa-minus-circle"></i></button></td>
                        </tr>
                      {% endfor %}
                    </tbody>
                    <tfoot>
                      <tr>
                        <td colspan="3"></td>
                        <td class="text-center"><button type="button" id="button-weight-value-add" class="btn btn-primary" title="{{ button_weight_value_add }}"><i class="fa-solid fa-plus-circle"></i></button></td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              </div>

            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
document.addEventListener('DOMContentLoaded', function() {
	var catAvailable = document.getElementById('cat-available');
	var catSelected = document.getElementById('cat-selected');
	var catCount = document.getElementById('cat-selected-count');

	function sortOptions(select) {
		var options = Array.prototype.slice.call(select.options);

		options.sort(function(a, b) {
			return a.text.localeCompare(b.text, 'bg');
		});

		options.forEach(function(option) {
			select.appendChild(option);
		});
	}

	function moveSelected(from, to) {
		Array.prototype.slice.call(from.selectedOptions).forEach(function(option) {
			to.appendChild(option);
		});

		sortOptions(to);

		catCount.textContent = catSelected.options.length;
	}

	function moveAll(from, to) {
		Array.prototype.slice.call(from.options).forEach(function(option) {
			to.appendChild(option);
		});

		sortOptions(to);

		catCount.textContent = catSelected.options.length;
	}

	document.getElementById('cat-add').addEventListener('click', function() {
		moveSelected(catAvailable, catSelected);
	});

	document.getElementById('cat-add-all').addEventListener('click', function() {
		moveAll(catAvailable, catSelected);
	});

	document.getElementById('cat-remove').addEventListener('click', function() {
		moveSelected(catSelected, catAvailable);
	});

	document.getElementById('cat-remove-all').addEventListener('click', function() {
		moveAll(catSelected, catAvailable);
	});

	document.getElementById('cat-search').addEventListener('input', function() {
		var term = this.value.toLowerCase();

		Array.prototype.slice.call(catAvailable.options).forEach(function(option) {
			option.hidden = option.text.toLowerCase().indexOf(term) === -1;
		});
	});

	document.getElementById('form-shipping').addEventListener('submit', function() {
		Array.prototype.slice.call(catSelected.options).forEach(function(option) {
			option.selected = true;
		});
	});

	// Weight ranges
	var weightTable = document.getElementById('weight-value').getElementsByTagName('tbody')[0];

	function addWeightRow() {
		var index = weightTable.getElementsByTagName('tr').length + 1;
		var row = document.createElement('tr');

		row.innerHTML = '<td><input type="text" name="shipping_boxnow_weight_value[' + index + '][from]" placeholder="0.00" class="form-control"/></td>' +
			'<td><input type="text" name="shipping_boxnow_weight_value[' + index + '][to]" placeholder="0.00" class="form-control"/></td>' +
			'<td><input type="text" name="shipping_boxnow_weight_value[' + index + '][price]" placeholder="0.00" class="form-control"/></td>' +
			'<td class="text-center"><button type="button" class="btn btn-danger btn-boxnow-row-remove"><i class="fa-solid fa-minus-circle"></i></button></td>';

		weightTable.appendChild(row);
	}

	document.getElementById('button-weight-value-add').addEventListener('click', addWeightRow);

	weightTable.addEventListener('click', function(e) {
		var button = e.target.closest('.btn-boxnow-row-remove');

		if (button) {
			button.closest('tr').remove();
		}
	});
});
//--></script>
{{ footer }}
